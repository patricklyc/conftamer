        "seq": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "capture_id",
        "process_id",
        "seq",
        "exchange_id",
        "kind",
        "context_id",
        "request",
        "api_id"
      ],
      "title": "RequestEvent",
      "type": "object"
    },
    "RequestLabel": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Host"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
