    "MetadataEvent": {
      "additionalProperties": false,
      "properties": {
        "api_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Id"
        },
        "capture_id": {
          "minLength": 1,
          "title": "Capture Id",
          "type": "string"
        },
        "exchange_id": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Exchange Id",
          "type": "integer"
        },
        "kind": {
          "const": "request_metadata",
          "title": "Kind",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Process Id",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "capture_id",
        "process_id",
        "seq",
        "exchange_id",
        "kind",
        "route",
        "api_id"
      ],
      "title": "MetadataEvent",
      "type": "object"
    },
    "RequestEvent": {
      "additionalProperties": false,
      "properties": {
        "api_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Id"
        },
        "capture_id": {
          "minLength": 1,
          "title": "Capture Id",
          "type": "string"
        },
        "context_id": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Id"
        },
        "exchange_id": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Exchange Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "send_request",
            "receive_request"
          ],
          "title": "Kind",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Process Id",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/RequestLabel"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
