      "required": [
        "method",
        "host",
        "path"
      ],
      "title": "RequestLabel",
      "type": "object"
    },
    "ResponseEvent": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "minLength": 1,
          "title": "Capture Id",
          "type": "string"
        },
        "exchange_id": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Exchange Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "send_response",
            "receive_response"
          ],
          "title": "Kind",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Process Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "status_code": {
          "maximum": 999,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "capture_id",
        "process_id",
        "seq",
        "exchange_id",
        "kind",
        "status_code"
      ],
      "title": "ResponseEvent",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "enum": [
            "go_serve_mux",
            "go_serve_mux_121",
            "httprouter"
          ],
          "title": "Dialect",
          "type": "string"
        },
        "full_pattern": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Full Pattern"
        },
        "matched_path": {
          "title": "Matched Path",
          "type": "string"
        },
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "dialect",
        "pattern",
        "matched_path",
        "full_pattern"
      ],
      "title": "Route",
      "type": "object"
    }
