  "discriminator": {
    "mapping": {
      "receive_request": "#/$defs/RequestEvent",
      "receive_response": "#/$defs/ResponseEvent",
      "request_metadata": "#/$defs/MetadataEvent",
      "send_request": "#/$defs/RequestEvent",
      "send_response": "#/$defs/ResponseEvent"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RequestEvent"
    },
    {
      "$ref": "#/$defs/ResponseEvent"
    },
    {
      "$ref": "#/$defs/MetadataEvent"
    }
  ]
}
